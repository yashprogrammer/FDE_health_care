# Copy to .env and fill in. Never commit .env. (Read by docker compose and by the local POC.)
GROQ_API_KEY=
LOGFIRE_TOKEN=

# Model + pricing (USD per 1M tokens, approximate - check Groq pricing page)
COPILOT_MODEL=groq:openai/gpt-oss-20b
PRICE_INPUT_PER_M=0.075
PRICE_OUTPUT_PER_M=0.30
USD_INR=88

# Set to 1 to never call the LLM (uses cached drafts / template fallback)
COPILOT_OFFLINE=0

# Local stack: optional demo password on the gateway (user "citycare"), ports
DEMO_PASSWORD=
MEDITRACK_PORT=8001
PG_PORT=5432
# if you change PG_PORT, point the native tools (poc-export, warm) at it too:
# MIS_DB_URL=postgresql://mis_report:mis_report@localhost:5432/citycare

# Optional: your Logfire project URL
LOGFIRE_PROJECT_URL=
