# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=
LOGFIRE_TOKEN=

# Model + pricing (USD per 1M tokens, approximate - check Groq pricing page)
COPILOT_MODEL=groq:openai/gpt-oss-20b
PRICE_INPUT_PER_M=0.075
PRICE_OUTPUT_PER_M=0.30
USD_INR=88

# Set to 1 to never call the LLM (uses cached drafts / template fallback)
COPILOT_OFFLINE=0
